# 이 파일을 복사해 .env 로 만들고 값을 채웁니다.
# .env 는 커밋되지 않습니다.
#
# 주의: .env 는 Docker Compose 가 읽는 파일입니다.
# IntelliJ 에서 서비스를 직접 실행할 때는 실행 구성(Run/Debug Configurations)의
# Environment variables 칸에 같은 값을 넣어야 합니다.

# 개발용 PostgreSQL (팀 공용 EC2)
DB_HOST=
DB_PASSWORD=

# 공통 모듈 내려받기용 GitHub 계정
# Gradle 빌드에서 쓰이므로 OS 환경변수로 두는 것이 확실합니다.
GPR_USER=
GPR_TOKEN=
